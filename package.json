{
  "name": "gossip-genie",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gossip Genie \u2014 family-friendly celebrity, health, facts and bizarre news, 30 stories a day, with a 24/7 Watch screen.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test pipeline/*.test.mjs src/lib/*.test.mjs market/*.test.mjs market/adapters/*.test.mjs netlify/lib/*.test.mjs",
    "run:local": "node scripts/run-local.mjs",
    "market:local": "node scripts/market-local.mjs",
    "market:mock": "node scripts/market-local.mjs --mock",
    "market:once": "node scripts/market-local.mjs --all",
    "fonts": "node scripts/fonts-to-ttf.mjs",
    "cards": "node scripts/card-proof.mjs",
    "price:calibrate": "node scripts/price-calibrate.mjs"
  },
  "dependencies": {
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "fflate": "^0.8.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@netlify/blobs": "^8.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": ">=20"
  }
}
